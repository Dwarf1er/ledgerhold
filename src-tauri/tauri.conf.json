{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ledgerhold",
  "version": "0.1.0",
  "identifier": "com.antoinepoulin.ledgerhold",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ledgerhold",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Antoine Poulin",
    "copyright": "Copyright (c) 2026 Antoine Poulin",
    "category": "Finance",
    "shortDescription": "Household bank ledger: import, dedupe, reconcile, export OFX",
    "longDescription": "Import bank statements from several banks into one local database, skip transactions you already have, track every account's balance from a known starting point, and export OFX for any date range.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
