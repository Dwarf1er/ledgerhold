# Optional: copy to .env to change these. Never commit .env.
# There is no password setting: you choose the household password in the browser on first run.

TZ=America/Toronto
LEDGERHOLD_PORT=3000
# Who may connect. 127.0.0.1 = this computer only (the safe default); 0.0.0.0 = your whole network.
LEDGERHOLD_BIND=127.0.0.1
